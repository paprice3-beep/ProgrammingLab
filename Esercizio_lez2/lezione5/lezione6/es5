from datetime import datetime

def calcola_compleanno():
    data_input = input("Inserisci la tua data di nascita (GG/MM/AAAA): ")
    
    try:
        data_nascita = datetime.strptime(data_input, "%d/%m/%Y")
    except ValueError:
        print("Formato non valido.")
        return

    oggi = datetime.now()
    
    eta = oggi.year - data_nascita.year
    if (oggi.month, oggi.day) < (data_nascita.month, data_nascita.day):
        eta -= 1

    anno_prossimo = oggi.year
    if (oggi.month, oggi.day) >= (data_nascita.month, data_nascita.day):
        anno_prossimo += 1
        
    prossimo_compleanno = data_nascita.replace(year=anno_prossimo)
    differenza = prossimo_compleanno - oggi
    
    giorni = differenza.days
    ore, resto = divmod(differenza.seconds, 3600)
    minuti, secondi = divmod(resto, 60)

    print(f"Età: {eta}")
    print(f"Mancano: {giorni} giorni, {ore} ore, {minuti} minuti, {secondi} secondi")

calcola_compleanno()